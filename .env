# CUDA Kandinsky — жёсткие дефолты под RTX 4070 16GB
MODEL_PATH=models/t2i-lite

# offload только тормозит; включать лишь при OOM
OFFLOAD=0
ATTENTION_SLICING=0

# первый прогон при старте (чтобы не «висеть» на первом HTTP-запросе)
WARMUP=1

# дефолты генерации (официальные размеры T2I)
# 640x1408 — очень высокий кадр, модель часто рисует «3 панели» в одном PNG
WIDTH=1024
HEIGHT=1024
STEPS=16
GUIDANCE=3.5
SEED=42

HOST=0.0.0.0
PORT=8000
